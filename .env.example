NEXT_PUBLIC_API_BASE_URL=https://api.tvmaze.com

# Server-side Supabase project settings (use the anon/publishable key, never service_role).
NEXT_SUPABASE_URL=https://your-project.supabase.co
NEXT_SUPABASE_ANON_KEY=your-supabase-anon-key

# Login page URL used for redirects; the handoff validates its origin.
LOGIN_URL=https://zynema-app.online/login.html

# Movie metadata and video provider credentials (server-side only).
TMDB_API_KEY=your-tmdb-api-key
# Alternatively, use TMDB_API_READ_ACCESS_TOKEN=your-tmdb-read-access-token
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
